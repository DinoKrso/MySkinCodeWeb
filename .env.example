# API (isti endpointi kao mobilna app)
VITE_API_BASE=https://3eft0vl4ka.execute-api.eu-central-1.amazonaws.com/dev
VITE_USER_PROFILE_ENDPOINT=https://4uyux7zjrf.execute-api.eu-central-1.amazonaws.com/dev/user/profile
VITE_DELETE_USER_ENDPOINT=https://4uyux7zjrf.execute-api.eu-central-1.amazonaws.com/dev/user
VITE_PROFILE_API_BASE=https://2gajkkmi0d.execute-api.eu-central-1.amazonaws.com/dev
VITE_FIREBASE_AUTH_EXCHANGE_ENDPOINT=https://ai8hjf2fsc.execute-api.eu-central-1.amazonaws.com/dev/auth/firebase
VITE_FIREBASE_SIGNUP_ENDPOINT=https://ai8hjf2fsc.execute-api.eu-central-1.amazonaws.com/dev/signup/firebase
VITE_ACTIVE_ROUTINE_ENDPOINT=https://c0cpdmd5ug.execute-api.eu-central-1.amazonaws.com/dev/routine/active

# Firebase Web SDK (Firebase Console → Project settings → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skincode-14a61.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skincode-14a61
VITE_FIREBASE_STORAGE_BUCKET=skincode-14a61.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Password reset (server-side only — nikad u VITE_* prefiks; obavezno na Vercelu)
RESEND_API_KEY=
RESEND_FROM=MySkinCode <noreply@myskincodeapp.com>
# Produkcija: postavi na https://www.myskincodeapp.com (na Vercelu Production env)
# Lokalno: http://localhost:5173 — na produkciji localhost u APP_BASE_URL se ignorira
APP_BASE_URL=https://www.myskincodeapp.com
PASSWORD_RESET_JWT_SECRET=
RESET_PASSWORD_API_URL=https://ai8hjf2fsc.execute-api.eu-central-1.amazonaws.com/dev/reset-password
# Opcionalno: direktan AWS check-email za serverless (inače koristi APP_BASE_URL/api/check-email)
CHECK_EMAIL_API_URL=https://3eft0vl4ka.execute-api.eu-central-1.amazonaws.com/dev/check-email

# Postavi na false samo ako API Gateway ima ispravan CORS i želiš direktne AWS URL-ove
# VITE_USE_API_PROXY=false

# Admin (samo web dashboard — postavi jaku lozinku na Vercelu Production)
VITE_ADMIN_EMAIL=admin@myskincodeapp.com
VITE_ADMIN_PASSWORD=

# Broj korisnika / proizvoda — ista Lambda, dvije rute na API Gateway
ADMIN_USERS_COUNT_URL=https://rdwp2lazqa.execute-api.eu-central-1.amazonaws.com/dev/admin/users/count
ADMIN_PRODUCTS_COUNT_URL=https://rdwp2lazqa.execute-api.eu-central-1.amazonaws.com/dev/admin/products/count
ADMIN_CREATE_PRODUCT_URL=https://rdwp2lazqa.execute-api.eu-central-1.amazonaws.com/dev/admin/products
ADMIN_PRODUCT_IMAGE_UPLOAD_URL=https://rdwp2lazqa.execute-api.eu-central-1.amazonaws.com/dev/admin/product-image-upload
ADMIN_API_KEY=
# Lambda env: PRODUCTS_TABLE_NAME=Products
# product-image-upload Lambda env:
PRODUCT_IMAGES_BUCKET=products-images-skincode
PRODUCT_IMAGES_PUBLIC_BASE=https://products-images-skincode.s3.eu-central-1.amazonaws.com
# Lokalno bez AWS: mock brojevi za UI test
# VITE_ADMIN_USERS_COUNT_MOCK=42
# VITE_ADMIN_PRODUCTS_COUNT_MOCK=128

# App Store / Google Play linkovi (stranica /download)
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# App → Web SSO handoff (mobilna app otvara /auth/app?token=...&userId=...&email=...&redirect=/plans?plan=plus&billing=monthly)
# Vidi src/lib/app-handoff.ts — buildAppHandoffUrl()

# Stripe / payment linkovi (Plus, Premium) — ostaje kao rezervna opcija
VITE_CHECKOUT_URL_PLUS=
VITE_CHECKOUT_URL_PLUS_YEARLY=
VITE_CHECKOUT_URL_PREMIUM=
VITE_CHECKOUT_URL_PREMIUM_YEARLY=
# VITE_CHECKOUT_URL_BASIC= opcionalno ako Basic ima poseban flow

# Monri WebPay (test: ipgtest.monri.com — produkcija: ipg.monri.com)
# Key i authenticity_token idu SAMO u .env i Vercel — nikad u ovaj file
MONRI_KEY=
MONRI_AUTHENTICITY_TOKEN=
MONRI_FORM_URL=https://ipgtest.monri.com/v2/form
MONRI_CURRENCY=BAM
MONRI_LANGUAGE=ba
# true dok ste na testnom okruženju — prikazuje crvenu obavijest kupcima
MONRI_TEST_MODE=true
VITE_MONRI_TEST_MODE=true
# U Monri merchant profilu postavite:
# Success URL = https://www.myskincodeapp.com/payment/success
# Cancel URL  = https://www.myskincodeapp.com/payment/cancel
# Callback URL = https://www.myskincodeapp.com/api/payments/monri/callback
# Redirect to success URL = true
# Opcionalno: Lambda koja na odobrenu uplatu postavlja subscriptionPlan / subscriptionExpiresAt
# Lambda POST /subscriptions/activate — vidi lambda/README.md
MONRI_ACTIVATE_SUBSCRIPTION_URL=https://rdwp2lazqa.execute-api.eu-central-1.amazonaws.com/dev/subscriptions/activate
# MONRI_ACTIVATE_SUBSCRIPTION_KEY=

# Podaci trgovca (obavezno za Monri / bankarsku inspekciju webshopa)
VITE_MERCHANT_LEGAL_NAME=
VITE_MERCHANT_TAX_ID=
VITE_MERCHANT_COMPANY_NUMBER=
VITE_MERCHANT_COURT=
VITE_MERCHANT_ADDRESS=
VITE_MERCHANT_CITY=
VITE_MERCHANT_COUNTRY=Bosna i Hercegovina
VITE_MERCHANT_PHONE=
VITE_MERCHANT_EMAIL=info@myskincodeapp.com
